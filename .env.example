# ============================================
# Model-Proxy v2 - runtime configuration
# ============================================

# Client auth (REQUIRED)
CLIENT_API_KEY=change-me-to-something-secret

# Network
HOST=0.0.0.0
PORT=9876
CORS_ORIGINS=*

# Deploy metadata + graceful drain
MODEL_PROXY_INSTANCE_COLOR=single
MODEL_PROXY_BUILD_ID=local
MODEL_PROXY_DRAIN_TIMEOUT_MS=300000

# Logging
LOG_LEVEL=info
VERBOSE_HTTP_ERRORS=false

# Key rotation + cooldowns
KEY_COOLDOWN_SECONDS=180
MAX_KEY_RETRY_CYCLES=1

# Tool-call enforcement (global defaults - can be overridden per-model)
ENFORCE_TOOL_CALL_MODE=false
TOOL_CALL_TERMINATION_FLAG={"tool_loop":"completed"}
TOOL_CALL_MAX_RETRIES=10
STREAM_CHUNK_DELAY=0
EMPTY_RESPONSE_POLICY=strict

# Optional in-memory request log cap. Leave blank to retain current-runtime metadata.
REQUEST_LOG_CAPACITY=
REQUEST_LOG_STALE_RUNNING_MS=1800000

# Persistent completion/analytics storage. Leave blank for <cwd>/.storage.
MODEL_PROXY_STORAGE_DIR=
# 32-byte base64url/hex key or passphrase. If omitted, a local 0600 key is generated.
MODEL_PROXY_CREDENTIAL_ENCRYPTION_KEY=
ANALYTICS_CACHE_HIT_WINDOW_MS=300000

# Optional OAuth endpoint overrides for tests/private identity brokers
# CODEX_OAUTH_ISSUER=https://auth.openai.com
# CODEX_OAUTH_CALLBACK_SERVER=true
# SUPERGROK_OAUTH_ISSUER=https://auth.x.ai
# SUPERGROK_CLIENT_VERSION=0.2.101

# Context window for GET /v1/models (when upstream + per-model config omit a value)
DEFAULT_CONTEXT_WINDOW=128000
UPSTREAM_MODELS_CACHE_TTL_SECONDS=3600
UPSTREAM_MODELS_FETCH_TIMEOUT_MS=2000

# Provider API keys (ADD YOUR OWN)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# CEREBRAS_API_KEY=...
# GEMINI_API_KEY=...

# Audio transcription providers
# NVIDIA_NIM_ASR_BASE_URL=http://127.0.0.1:9000
# NVIDIA_NIM_API_KEY=nvapi-or-ngc-key
