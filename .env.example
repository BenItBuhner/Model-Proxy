# ============================================
# Model-Proxy Configuration (Bun + TypeScript)
# ============================================

# Client authentication (required)
CLIENT_API_KEY=ExampleKeyForClient

# Server Configuration
# HOST=127.0.0.1
# PORT=9876

# Gemini API Keys
# GEMINI_API_KEY_1=AIzaSy...
# GEMINI_API_KEY_2=AIzaSy...
# GEMINI_API_KEY_3=AIzaSy...

# Gemini Settings
# GEMINI_INCLUDE_THOUGHT_SIGNATURE=false

# Cerebras API Keys
# CEREBRAS_API_KEY_1=csk-...
# CEREBRAS_API_KEY_2=csk-...

# Groq API Keys
# GROQ_API_KEY_1=gsk_...
# GROQ_API_KEY_2=gsk_...

# Mistral API Keys
# MISTRAL_API_KEY_1=...
# MISTRAL_API_KEY_2=...

# OpenRouter API Keys
# OPENROUTER_API_KEY_1=sk-or-v1-...
# OPENROUTER_API_KEY_2=sk-or-v1-...

# OpenAI API Keys
# OPENAI_API_KEY_1=sk-...
# OPENAI_API_KEY_2=sk-...

# Anthropic API Keys
# ANTHROPIC_API_KEY_1=sk-ant-...
# ANTHROPIC_API_KEY_2=sk-ant-...

# Key Rotation Settings
# KEY_COOLDOWN_SECONDS=180     # Seconds before failed keys can be retried (default: 180)
# MAX_KEY_RETRY_CYCLES=1       # Cycles through keys before next provider (default: 1)

# Debugging & Logging
LOG_LEVEL=DEBUG
VERBOSE_HTTP_ERRORS=false

# CORS
# CORS_ORIGINS=*

# Startup validation
# FAIL_ON_STARTUP_VALIDATION=false
# REQUIRE_CLIENT_API_KEY=false
