# ============================================================
# Model-Proxy v2 (Bun / TypeScript)
# ============================================================

# Runtime dependencies
node_modules/
.pnp/
.pnp.js
.yarn/*

# Bun
bun.lockb
.bun/

# Build output
dist/
build/
.next/
out/
web/out/
web-static/

# TypeScript
*.tsbuildinfo
tsconfig.tsbuildinfo

# Environment
.env
.env.local
.env.development
.env.test
.env.production
.env.staging

# Runtime model discovery cache
config/models.json

# Per-model user-editable configs (tracked on the server, not in git)
config/models/
config/providers/

# Logs
*.log
logs/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Local agent context
.claude/

# Python cruft (leftover, should not reappear)
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
uv.lock
sql_app.db

# Wizard progress + state
.model-proxy-setup-progress

# Keep these tracked (negations):
!config/providers/.gitkeep
!config/models/.gitkeep
