# ============================================================
# Model-Proxy v2 (Bun / TypeScript)
# ============================================================

# Runtime dependencies
node_modules/
.pnp/
.pnp.js
.yarn/*

# Bun
bun.lockb
.bun/

# Build output
dist/
build/
.next/
out/
apps/web/out/
web-static/

# TypeScript
*.tsbuildinfo
tsconfig.tsbuildinfo

# Environment
.env
.env.local
.env.development
.env.test
.env.production
.env.staging

# Runtime model discovery cache
config/models.json

# Per-model user-editable configs (tracked on the server, not in git)
config/models/*
config/providers/*

# Logs
*.log
logs/
.storage/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Local agent context
.claude/
.playwright-mcp/

# Root dev install (use web/node_modules for the admin UI)
/node_modules/

# Deploy state
deploy/bluegreen-state.env

# Keep these tracked (negations):
!config/providers/.gitkeep
!config/models/.gitkeep
