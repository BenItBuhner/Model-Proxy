{
  "name": "supergrok",
  "display_name": "SuperGrok / X Premium+ Subscription",
  "enabled": true,
  "api_keys": {
    "env_var_patterns": [],
    "description": "Managed xAI OAuth accounts attached from the Accounts page."
  },
  "endpoints": {
    "base_url": "https://cli-chat-proxy.grok.com/v1",
    "completions": "/chat/completions",
    "streaming": "/chat/completions",
    "responses": "/responses",
    "responses_streaming": "/responses",
    "compatible_format": "responses"
  },
  "authentication": {
    "type": "bearer",
    "header_name": "Authorization",
    "header_format": "Bearer {api_key}"
  },
  "request_config": {
    "timeout_seconds": 120,
    "max_retries": 0,
    "retry_on_status": [429, 500, 502, 503, 504],
    "default_parameters": {},
    "required_parameters": []
  },
  "rate_limiting": {
    "enabled": false,
    "cooldown_seconds": 180
  },
  "models": {
    "grok-4.6": { "context_length": 200000 },
    "grok-4.5": { "context_length": 200000 }
  },
  "error_handling": {
    "401": { "action": "global_key_failure" },
    "403": { "action": "global_key_failure" },
    "429": { "action": "model_key_failure" },
    "500": { "action": "model_key_failure" },
    "502": { "action": "model_key_failure" },
    "503": { "action": "model_key_failure" },
    "504": { "action": "model_key_failure" }
  },
  "model_mapping": {}
}
