{
  "name": "nvidia-riva-asr",
  "display_name": "NVIDIA Hosted Riva ASR (gRPC)",
  "enabled": true,
  "api_keys": {
    "env_var_patterns": ["NVIDIA_NIM_API_KEY", "NVIDIA_API_KEY", "NGC_API_KEY"]
  },
  "endpoints": {
    "base_url": "https://grpc.nvcf.nvidia.com:443",
    "completions": "/nvidia.riva.asr.RivaSpeechRecognition/Recognize",
    "compatible_format": "openai"
  },
  "authentication": {
    "type": "bearer",
    "header_name": "authorization",
    "header_format": "Bearer {api_key}"
  },
  "request_config": {
    "timeout_seconds": 120,
    "max_retries": 0,
    "retry_on_status": [429, 500, 502, 503, 504],
    "default_parameters": {},
    "required_parameters": []
  },
  "rate_limiting": {
    "enabled": false,
    "cooldown_seconds": 180
  },
  "models": {},
  "error_handling": {
    "401": { "action": "global_key_failure" },
    "403": { "action": "global_key_failure" },
    "429": { "action": "provider_cooldown" },
    "500": { "action": "model_key_failure" },
    "502": { "action": "model_key_failure" },
    "503": { "action": "model_key_failure" },
    "504": { "action": "model_key_failure" }
  },
  "model_mapping": {}
}
